{
  "name": "the-system",
  "version": "1.0.0",
  "private": true,
  "description": "THE SYSTEM MERN application",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev:server": "npm run dev --workspace=the-system-server",
    "dev:client": "npm run dev --workspace=the-system-client",
    "build": "npm run build --prefix client",
    "test:browser": "playwright test --config=playwright.config.cjs",
    "test:browser:smoke": "playwright test --config=playwright.config.cjs tests/browser/smoke.spec.cjs",
    "browser:routes": "node scripts/discover-browser-routes.cjs",
    "start": "npm run start --prefix server"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1"
  }
}

NODE_ENV=development
PORT=5001
APP_REVIEW_MODE=false
# Local replica set is required for account storage and transactional flows.
MONGODB_URI=mongodb://127.0.0.1:27017/the-system?replicaSet=rs0
# Used only by the explicit seed-account migration preview/apply command.
DEV_IDENTITY_SELECTOR=local-development-user
# Exact local browser origin used by Vite and Google OAuth.
CORS_ORIGINS=http://localhost:5175
# Generate independent random values locally; never commit real values.
AUTH_SESSION_SECRET=
RECOVERY_CODE_HMAC_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5175/api/v1/auth/google/callback
AUTH_TRUSTED_ORIGINS=http://localhost:5175
APP_BASE_URL=http://localhost:5175
AUTH_TRUST_PROXY_HOPS=0
